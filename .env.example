# ==============================================================================
# PERSONAL IDENTIFICATION (Target data to remove from data brokers)
# ==============================================================================
# Full name used in legal GDPR / CCPA erasure requests
USER_FULL_NAME=
# Comma-separated list of email addresses to locate and delete
USER_EMAILS=
# Optional phone number associated with data broker profiles (e.g. +1 555 123 4567)
USER_PHONE=

# ==============================================================================
# OPENROUTER AI CONFIGURATION (Free Tier Models with Automatic Failover)
# ==============================================================================
# Get a free API key at: https://openrouter.ai/keys
# Oblivion cascades through: Gemini 2.0 Flash, Llama 3.3 70B, Mistral 24B, Qwen 72B
OPENROUTER_API_KEY=

# ==============================================================================
# TELEGRAM BOT (Remote Control & Real-time Alerts)
# ==============================================================================
# Create a bot via @BotFather on Telegram and paste the token here
TELEGRAM_BOT_TOKEN=
# Get your numeric user ID by messaging @userinfobot on Telegram
TELEGRAM_CHAT_ID=

# ==============================================================================
# MAIL SERVICE (SMTP Sending & IMAP Inbox Polling)
# ==============================================================================
# For Gmail, enable 2FA and generate an App Password at: https://myaccount.google.com/apppasswords
EMAIL_USER=
EMAIL_PASSWORD=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

IMAP_HOST=imap.gmail.com
IMAP_PORT=993

# ==============================================================================
# DATA BREACH MONITORING (Optional)
# ==============================================================================
# HaveIBeenPwned API key for automatic breach checks
HIBP_API_KEY=
